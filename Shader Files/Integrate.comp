#version 430 core
// Velocity Verlet, split into two halves around the force calculation:
//   stage 0:  x += v dt + 1/2 a dt^2   and   v += 1/2 a dt    (a = old acceleration)
//   stage 1:  v += 1/2 a dt                                    (a = new acceleration)
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Positions               { vec4 posMass[]; };     // xyz = position, w = mass
layout(std430, binding = 1) buffer Velocities              { vec4 velRadius[]; };   // xyz = velocity, w = draw radius
layout(std430, binding = 2) readonly buffer Accelerations  { vec4 acc[]; };

uniform uint numParticles;
uniform float dt;
uniform int stage;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= numParticles)
        return;

    vec3 a = acc[i].xyz;
    if (stage == 0)
        posMass[i].xyz += velRadius[i].xyz * dt + 0.5 * a * dt * dt;
    velRadius[i].xyz += 0.5 * a * dt;
}

#version 430 core
// Builds the Barnes-Hut tree from the sorted Morton codes, one internal node per thread, with no
// locks (Karras 2012, "Maximizing Parallelism in the Construction of BVHs, Octrees, and k-d Trees").
//
// Each internal node covers a run of sorted particles and splits it where their codes first differ.
// Because a Morton code is the octree path written as bits, this is the octree with each 8-way cell
// split stored as three 2-way splits (x, then y, then z), which is what lets it build in parallel.
//
// Node layout: internal nodes 0 .. N-2 (0 is the root), then leaves N-1 .. 2N-2 (leaf k = sorted particle k).
layout(local_size_x = 256) in;

struct Node
{
    vec4 centerOfMass;   // xyz = centre of mass, w = total mass   (filled in by TreeMass.comp)
    vec4 boxMin;         // bounding box of the particles inside    (filled in by TreeMass.comp)
    vec4 boxMax;
    ivec4 links;         // x = left child, y = right child, z = parent, w = visit counter for TreeMass.comp
};

layout(std430, binding = 3) readonly buffer Keys { uint keys[]; };
layout(std430, binding = 5) buffer Nodes         { Node nodes[]; };

uniform uint numParticles;

// Number of leading bits sorted codes i and j share (-1 if j is out of range). Equal codes are told
// apart by their position in the sorted list, so every particle still gets its own leaf.
int commonPrefix(int i, int j)
{
    if (j < 0 || j >= int(numParticles))
        return -1;
    uint keyI = keys[i];
    uint keyJ = keys[j];
    if (keyI == keyJ)
        return 32 + (31 - findMSB(uint(i ^ j)));
    return 31 - findMSB(keyI ^ keyJ);
}

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    int n = int(numParticles);
    if (i >= n - 1)
        return;

    // 1. which way does this node's run of particles extend from i?
    int d = (commonPrefix(i, i + 1) - commonPrefix(i, i - 1)) >= 0 ? 1 : -1;
    int minPrefix = commonPrefix(i, i - d);

    // 2. find the far end j of the run: double an upper bound, then binary search
    int maxRun = 2;
    while (commonPrefix(i, i + maxRun * d) > minPrefix)
        maxRun *= 2;
    int run = 0;
    for (int stride = maxRun / 2; stride >= 1; stride /= 2)
        if (commonPrefix(i, i + (run + stride) * d) > minPrefix)
            run += stride;
    int j = i + run * d;

    // 3. find the split: the last particle that shares more leading bits with i than j does
    int nodePrefix = commonPrefix(i, j);
    int split = 0;
    int stride = run;
    do
    {
        stride = (stride + 1) / 2;
        if (commonPrefix(i, i + (split + stride) * d) > nodePrefix)
            split += stride;
    } while (stride > 1);
    int gamma = i + split * d + min(d, 0);

    // 4. children: a leaf if the child's run is a single particle, otherwise internal node gamma / gamma + 1
    int firstLeaf = n - 1;
    int left  = (min(i, j) == gamma)     ? firstLeaf + gamma     : gamma;
    int right = (max(i, j) == gamma + 1) ? firstLeaf + gamma + 1 : gamma + 1;

    nodes[i].links.x = left;
    nodes[i].links.y = right;
    nodes[i].links.w = 0;        // reset the visit counter for TreeMass.comp
    nodes[left].links.z = i;     // parent pointers
    nodes[right].links.z = i;
    if (i == 0)
        nodes[0].links.z = -1;   // the root has no parent
}
